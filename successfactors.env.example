# Copy this file to successfactors.env and fill in the blanks.
# On BTP, set the same names as environment variables for the qr-connect app, then restage.
# Leave the connection blank to keep the sample directory.

# OData v2 root, for example https://api12.sapsf.com/odata/v2
SUCCESSFACTORS_API_URL=
SUCCESSFACTORS_COMPANY_ID=
SUCCESSFACTORS_USERNAME=
SUCCESSFACTORS_PASSWORD=

# Password people use to sign in to this app after their profile is loaded.
SUCCESSFACTORS_APP_PASSWORD=

# Company website stored on every card. SuccessFactors has no standard website field.
SUCCESSFACTORS_WEBSITE=

# Which employees to load. Change this if your tenant does not use status 't' for active.
SUCCESSFACTORS_USER_FILTER=status eq 't'

# Card fields. Change the right-hand side to the field name in your User entity.
SUCCESSFACTORS_FIELD_FIRST_NAME=firstName
SUCCESSFACTORS_FIELD_LAST_NAME=lastName
SUCCESSFACTORS_FIELD_ROLE=title
SUCCESSFACTORS_FIELD_ORGANISATION=division
SUCCESSFACTORS_FIELD_CELLPHONE=cellPhone
SUCCESSFACTORS_FIELD_EMAIL=email
SUCCESSFACTORS_FIELD_USERNAME=username
SUCCESSFACTORS_FIELD_USER_ID=userId
SUCCESSFACTORS_FIELD_MANAGER=manager/userId
