{
  "name": "qr-connect",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.2.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "@sap/hana-client": "^2.30.32",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "redis": "^5.8.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "@sap/hdi-deploy": "^5.7.0"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node srv/start.js",
    "test": "node --test"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "dummy"
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      }
    }
  },
  "private": true
}
