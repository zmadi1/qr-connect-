# Copy this file to servicenow.env and fill in the first three values.
# On BTP, set the same names with cf set-env, then restage.
# Leave the connection blank until you are ready. The Send to ServiceNow button
# stays on each lead and explains what is missing.

# Instance root, with no path. Example: https://bcx.service-now.com
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Leave the table blank to use the ServiceNow Lead API.
# Set a table name to use the Table API instead, for example sn_lead or a custom table.
# SERVICENOW_TABLE=

# Name stored as the external system on the new record.
SERVICENOW_EXTERNAL_SYSTEM=QR Connect

# Field names. Uncomment a line to point it at a different column.
# Set a line to off to leave that value out of the record.
# The company name is sent as text. On a table where company is a reference,
# set SERVICENOW_FIELD_COMPANY=off and keep the name in the description.
# SERVICENOW_FIELD_FIRST_NAME=first_name
# SERVICENOW_FIELD_SURNAME=last_name
# SERVICENOW_FIELD_EMAIL=email
# SERVICENOW_FIELD_PHONE=business_phone
# SERVICENOW_FIELD_COMPANY=company
# SERVICENOW_FIELD_SUMMARY=short_description
# SERVICENOW_FIELD_DETAILS=description
# SERVICENOW_FIELD_EXTERNAL_ID=external_id
# SERVICENOW_FIELD_EXTERNAL_SYSTEM=external_system
